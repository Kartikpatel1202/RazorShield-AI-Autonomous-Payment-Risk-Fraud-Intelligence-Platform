
# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL. Use host "localhost" when running the backend directly and
# "postgres" when running inside Docker Compose.
DATABASE_URL=postgresql+psycopg://razorshield:change-me@localhost:5432/razorshield

# Credentials consumed by the postgres container in docker-compose.yml.
POSTGRES_USER=razorshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=razorshield
POSTGRES_PORT=5432

# --- Authentication ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The value below is a placeholder and is REFUSED at startup in any environment
# other than `local` - copying this file and deploying it will not silently
# leave you signing tokens with a value published in this repository.
JWT_SECRET=replace-with-a-long-random-string
# How long an access token stays valid. Short, because a JWT cannot be revoked.
ACCESS_TOKEN_TTL_MINUTES=60

# --- Password reset ----------------------------------------------------------
# There is no SMTP integration in this project. With this on, POST
# /api/auth/forgot-password returns the reset link in its response instead of
# emailing it, so the flow can be exercised locally.
#
# The application REFUSES TO START with this enabled and ENVIRONMENT=production.
# It hands a password-reset capability to whoever asked for one, and it is also
# an account-existence oracle - a registered address gets a link and an
# unregistered one does not.
AUTH_EXPOSE_DEV_RESET_TOKEN=true
# Origin the reset link points at: the console, not the API.
FRONTEND_BASE_URL=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
# Fixed-window counters, held in this process. See docs/security.md for the
# multi-worker limitation. Set a limit to 0 to disable that bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_INGEST_PER_MINUTE=600
RATE_LIMIT_SIMULATOR_PER_MINUTE=30
RATE_LIMIT_FEEDBACK_PER_MINUTE=60
RATE_LIMIT_REVIEW_PER_MINUTE=60

# --- HTTP hardening ----------------------------------------------------------
# Emit Strict-Transport-Security. Leave false unless the API is served over
# HTTPS: on an http:// origin the header is ignored, and turning it on before
# TLS works is how a domain becomes unreachable.
HSTS_ENABLED=false
MAX_REQUEST_BYTES=1048576

# --- Database pool -----------------------------------------------------------
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
# PostgreSQL statement_timeout, milliseconds. 0 disables it. Ignored by SQLite.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- AI risk investigation agent ---------------------------------------------
# Provider for the Phase 5 investigation agent.
#   mock              deterministic test double; no API key needed, and every
#                     investigation it produces is flagged agent_is_mock=true
#   anthropic         Claude via the official SDK
#   openai_compatible any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5
LLM_API_KEY=
# Only used by the openai_compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# Hard cap on the agent's tool-selection rounds. The loop always terminates.
AGENT_MAX_ITERATIONS=8

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Exact match,
# scheme included, no trailing slash. `*` is REFUSED at startup: this API sends
# credentials, and the CORS spec forbids the wildcard in that combination -
# Starlette would silently drop it and every browser request would still fail.
#
# In production this must contain the deployed console's origin, e.g.
#   CORS_ORIGINS=https://razor-shield-ai-autonomous-payment.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional regular expression matching ADDITIONAL origins, anchored at both
# ends. This exists for preview platforms that mint a new hostname per build:
# Vercel does, so an exact list alone would need editing and a redeploy of the
# API for every preview URL.
#
# Scope it to your own project. This pattern matches the previews of one Vercel
# project and nothing else:
#   CORS_ORIGIN_REGEX=^https://razor-shield-ai-[a-z0-9-]+\.vercel\.app$
# Never widen it to ^https://[a-z0-9-]+\.vercel\.app$ - that trusts every
# account on the platform.
CORS_ORIGIN_REGEX=

# --- Frontend ----------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_API_BASE_URL=http://localhost:8000

# --- Deployment bootstrap ----------------------------------------------------
# `backend/scripts/bootstrap.py` brings an empty database to a usable state:
# migrations, dataset, Phase 3 predictions, Phase 4 signals, Phase 6 decisions,
# and the operator accounts below. Every stage is skipped when its output
# already exists, so it is safe to run on every deploy.
#
# With this true the container entrypoint runs it in the BACKGROUND and serves
# the API immediately - a multi-minute seed must not delay the port bind, or the
# platform marks the deploy failed and retries it.
BOOTSTRAP_ON_START=false

# Dataset size when the transactions table is empty. The 20,000 of
# scripts/seed_data.py is sized for local model training; this is sized to
# finish over a network hop to a managed database while still filling every
# dashboard aggregate and the trend chart.
BOOTSTRAP_TRANSACTIONS=3000

# How long the Phase 5 investigation stage may run before it hands the rest of
# the backlog to the next bootstrap. It is the only stage that calls a language
# model, so it is the only one whose duration is set outside this process - and
# the decision stage that fills the dashboard runs after it. Bounded so a slow
# provider costs investigations rather than costing every decision.
BOOTSTRAP_INVESTIGATION_SECONDS=300

# The account that can operate the simulator.
#
# Signup deliberately always creates a VIEWER and has no role field, so an
# administrator cannot be created over HTTP - see scripts/manage_users.py for
# why there is no POST /api/users. This is how the first one comes to exist.
#
# Both must be set or the account stage is skipped: no password is ever
# defaulted or generated. Minimum 12 characters. Treat these as secrets - they
# belong in the host's secret store, never in the repository, and never in a
# VITE_-prefixed variable, which Vite compiles into the browser bundle.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional second account, for demonstrating what a read-only role is refused.
BOOTSTRAP_VIEWER_EMAIL=
BOOTSTRAP_VIEWER_PASSWORD=
