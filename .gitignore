# --- ML artefacts ------------------------------------------------------------
# Datasets and serialised models are build outputs, rebuilt by
# `python -m ml.training.build_dataset` and `python -m ml.training.train`.
# metrics.json and feature_importance.json ARE tracked: they are the source the
# generated evaluation report is rendered from.
ml/data/raw/
ml/data/processed/
*.pkl
*.joblib

